# --- Core ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database (optional: omit to run fully in-memory) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/cinesync

# --- Storage ---
# MUST be outside the source tree.
UPLOAD_DIR=/var/lib/cinesync/uploads
MAX_UPLOAD_SIZE_MB=2048

# --- WebRTC ---
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=
