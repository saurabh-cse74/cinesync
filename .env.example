# --- Core ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database (optional: omit to run fully in-memory) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/cinesync

# --- Storage ---
# Use a writable folder for your system. Example values:
# Windows: C:\Temp\cinesync-uploads
# Linux/macOS: /tmp/cinesync-uploads
UPLOAD_DIR=C:\Temp\cinesync-uploads
MAX_UPLOAD_SIZE_MB=2048

# --- WebRTC ---
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=
